# Backend Environment Variables
#
# HOW TO USE:
#   Copy this file to `.env` in the backend/ directory.
#   `.env` is gitignored — it will never be committed.
#
# LOADING IN SPRING BOOT:
#   Spring Boot does NOT load .env files automatically.
#   Use one of these approaches:
#     Option A: Set environment variables in your OS/IDE run configuration
#     Option B: Use IntelliJ's "EnvFile" plugin which reads .env automatically
#     Option C: Pass them via command line: DB_PASSWORD=secret ./mvnw spring-boot:run
#
# IMPORTANT:
#   NEVER put real secrets in application.yml or commit them to Git.
#   The ${ENV_VAR:default} syntax in application.yml reads from the environment.

# ─────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────

# Full JDBC URL for PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/securecommerce

# PostgreSQL username
DB_USERNAME=postgres

# PostgreSQL password — replace with your actual password
DB_PASSWORD=your_postgres_password

# ─────────────────────────────────────────
# JWT (Authentication Phase)
# ─────────────────────────────────────────

# Must be at least 256 bits (32+ characters) for HS256 algorithm
# Generate with: openssl rand -base64 64
JWT_SECRET=replace-this-with-a-real-256-bit-secret-generated-by-openssl-rand

# Token lifetime in milliseconds
# 86400000 = 24 hours
JWT_EXPIRATION_MS=86400000

# Refresh token lifetime: 604800000 = 7 days
JWT_REFRESH_MS=604800000

# ─────────────────────────────────────────
# SERVER
# ─────────────────────────────────────────

SERVER_PORT=8080

# ─────────────────────────────────────────
# CORS
# ─────────────────────────────────────────

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# ─────────────────────────────────────────
# SPRING PROFILE
# ─────────────────────────────────────────

# Set active Spring profile: dev | test | prod
SPRING_PROFILES_ACTIVE=dev

# ─────────────────────────────────────────
# RAZORPAY PAYMENT GATEWAY
# ─────────────────────────────────────────
# Gateway Operation Mode: TEST | LIVE
#   TEST mode: Enforces rzp_test_* keys. Rejects rzp_live_* keys immediately on startup.
#   LIVE mode: Enforces rzp_live_* keys. Rejects rzp_test_* keys and missing secrets immediately on startup.
RAZORPAY_MODE=TEST

# Razorpay API Credentials
# For TEST Mode: Must start with rzp_test_ (or use rzp_test_shopivo_dev_key for local development without live API calls)
# For LIVE Mode: Must start with rzp_live_
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Razorpay Webhook Secret (configured in Razorpay Dashboard > Settings > Webhooks)
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Currency (must be INR for India Razorpay standard checkout)
RAZORPAY_CURRENCY=INR

# ─────────────────────────────────────────
# GOOGLE OAUTH 2.0 (Web Client ID)
# ─────────────────────────────────────────
# Must match VITE_GOOGLE_CLIENT_ID configured in frontend/.env.local
# Format: <project-number>-<hash>.apps.googleusercontent.com
GOOGLE_CLIENT_ID=
SELLER_REQUIRE_APPROVAL=false

# ─────────────────────────────────────────
# EMAIL DELIVERY (SMTP)
# ─────────────────────────────────────────
# Required for Password Reset OTP verification emails
# Example for Gmail: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_USERNAME=you@gmail.com, MAIL_PASSWORD=app_password
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@shopivo.com
MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

# ─────────────────────────────────────────
# GO-LIVE PRODUCTION CHECKLIST:
# ─────────────────────────────────────────
# 1. Complete KYC and activate Razorpay Merchant Account on https://dashboard.razorpay.com
# 2. Switch Dashboard to LIVE mode and generate Live API Keys (rzp_live_...)
# 3. Configure Webhook URL: https://<your-domain>/api/payments/webhook
#    Enable events: payment.captured, payment.failed, refund.created, refund.processed, refund.failed
# 4. Set RAZORPAY_MODE=LIVE
# 5. Set RAZORPAY_KEY_ID=rzp_live_...
# 6. Set RAZORPAY_KEY_SECRET=<live_secret>
# 7. Set RAZORPAY_WEBHOOK_SECRET=<live_webhook_secret>
# 8. Set SPRING_PROFILES_ACTIVE=prod
# 9. Set VITE_RAZORPAY_KEY_ID=rzp_live_... in frontend/.env.local or frontend production environment
# 10. Perform a ₹1 real UPI transaction (Google Pay/PhonePe) to verify end-to-end capture and refund.
