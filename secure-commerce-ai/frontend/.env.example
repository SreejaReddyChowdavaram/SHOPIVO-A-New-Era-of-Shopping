# Frontend Environment Variables
#
# HOW TO USE:
#   Copy this file to `.env.local` (gitignored by default in Vite).
#   Vite reads .env.local automatically — no plugin needed.
#
# VITE RULE: All frontend env vars MUST start with VITE_
#   They are inlined into the JS bundle at build time.
#   NEVER put secrets here — they are visible in the browser.

# Backend API base URL — must match the Spring Boot server.port + context-path
# Local dev: http://localhost:8080/api
# Render Production Static Site: https://shopivo-a-new-era-of-shopping.onrender.com/api
VITE_API_URL=http://localhost:8080/api

# Razorpay Public Key ID (Client-side Standard Checkout popup)
# NEVER put Key Secret or Webhook Secret here! Only public key ID is safe for frontend.
# Format: rzp_test_... (Test Mode) or rzp_live_... (Live Mode)
VITE_RAZORPAY_KEY_ID=

# Google OAuth 2.0 Web Client ID (Public client identifier)
# NEVER put Client Secret here! Only public Web Client ID is safe for frontend.
# Format: <project-id>-<hash>.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=

# App display name (optional, shown in page titles)
VITE_APP_NAME=SecureCommerce AI
